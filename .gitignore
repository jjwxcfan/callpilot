.env
.venv/
__pycache__/
*.pyc

# 运行时数据（含短信记录/日志，可能包含隐私）
data/
!data/
data/*
!data/number_profiles.example.json
!data/call_playbooks.example.json
# DTMF judge cleartext analysis stays inside private per-call records.
**/judge_shadow.jsonl

# 生成的音频文件
*.wav

# Claude Code 会话产物
.claude/
# codex 配对对话记录（会话产物，含本机路径/内部信息 —— 铁律：永不提交）
.codex_dialog.md
*.codex_dialog.md
.DS_Store
packaging/icon_work/CallPilot.iconset/

# 打包与图标产物（不入源码库）
build/
dist/
*.pkg
packaging/icon_work/
packaging/*.icns

# 本地开发运作(个人/本机编排,不入库)
CLAUDE.local.md

# setuptools/pip install -e 构建产物(不入库)
*.egg-info/
.playwright-cli/

# Cloud control-plane local state and secrets
cloud/node_modules/
cloud/.wrangler/
cloud/.dev.vars
cloud/coverage/

# iOS (xcodegen 生成工程 + 构建产物,不入库;project.yml 与源码入库)
ios/*.xcodeproj/
ios/DerivedData/
ios/build/
ios/**/xcuserdata/
ios/*.ipa
ios/Pods/

# ---- 本机工作区里的「非本仓库」资产：既不入库，也别让 git add -A 扫进来 ----
# 会话归档（数百 MB，含真实号码/IMEI/API key）——绝不入库，开源后无法收回。
agentcall-sessions/
# 前身代码库快照（自带 git 历史，属独立项目）。
AgentAssistant/
# 工具/编辑器的本地状态目录。
.gstack/
# 硬件评审稿的二进制导出件（.md 版本入库即可）。
docs/*.docx
